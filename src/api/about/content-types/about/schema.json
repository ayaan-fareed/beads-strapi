{
  "kind": "collectionType",
  "collectionName": "abouts",
  "info": {
    "singularName": "about",
    "pluralName": "abouts",
    "displayName": "productss",
    "description": "Write about yourself and the content you create"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "image": {
      "type": "media",
      "multiple": true,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "category": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "Necklaces",
        "Earrings",
        "Rings",
        "Bracelets"
      ]
    },
    "badge": {
      "type": "enumeration",
      "enum": [
        "New",
        "Hot",
        "Best Seller",
        "None"
      ]
    },
    "description": {
      "type": "string",
      "required": true
    },
    "price": {
      "type": "integer",
      "required": true
    },
    "available": {
      "type": "boolean"
    }
  }
}
