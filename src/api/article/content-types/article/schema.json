{
  "kind": "collectionType",
  "collectionName": "articles",
  "info": {
    "singularName": "article",
    "pluralName": "articles",
    "displayName": "product",
    "description": "Create your blog content"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "string",
      "maxLength": 80,
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "image": {
      "type": "media",
      "multiple": true,
      "required": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "category": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "Necklaces",
        "Earrings",
        "Rings",
        "Bracelets",
        "Best Seller"
      ]
    },
    "badge": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "New",
        "Hot",
        "Best Seller",
        "None"
      ]
    },
    "price": {
      "type": "integer",
      "required": true
    },
    "available": {
      "type": "boolean",
      "required": true
    }
  }
}
